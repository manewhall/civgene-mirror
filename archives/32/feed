	<item>
		<title>By: Proto-psychopaths and Meta-psychopaths &#124; The Civilization Gene</title>
		<link>http://civgene.matthewnewhall.com/archives/32#comment-5</link>
		<dc:creator>Proto-psychopaths and Meta-psychopaths &#124; The Civilization Gene</dc:creator>
