		<comments>http://civgene.matthewnewhall.com/archives/874#comments</comments>
		<pubDate>Wed, 20 May 2015 19:04:18 +0000</pubDate>
		<dc:creator>Matthew Newhall</dc:creator>
				<category><![CDATA[civilization gene]]></category>
		<category><![CDATA[conscience]]></category>
