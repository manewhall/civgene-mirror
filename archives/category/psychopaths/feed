		<title>The terror of rational clarity</title>
		<link>http://civgene.matthewnewhall.com/archives/1316</link>
		<comments>http://civgene.matthewnewhall.com/archives/1316#comments</comments>
		<pubDate>Sat, 01 Oct 2016 03:45:47 +0000</pubDate>
		<dc:creator>Matthew Newhall</dc:creator>
