		<title>Detailed explanation of childhood amnesia</title>
		<link>http://civgene.matthewnewhall.com/archives/272</link>
		<comments>http://civgene.matthewnewhall.com/archives/272#comments</comments>
		<pubDate>Fri, 25 Oct 2013 16:43:27 +0000</pubDate>
		<dc:creator>Matthew Newhall</dc:creator>
